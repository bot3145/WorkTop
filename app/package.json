{
  "name": "worktop",
  "private": true,
  "version": "3.1.0",
  "description": "Worktop — 本地优先的个人工作台桌面版：待办/导航/资产/凭据/速记 + 桌面壳、Dock 与桌宠（Tauri 2 + Vue 3 + Rust）",
  "license": "MIT",
  "author": "Worktop contributors",
  "type": "module",
  "keywords": [
    "tauri",
    "vue",
    "desktop",
    "obsidian",
    "markdown",
    "personal-workbench"
  ],
  "engines": {
    "node": ">=20.19",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
