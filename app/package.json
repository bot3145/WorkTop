    "tauri:build": "tauri build",
    "airsnip:fetch": "node scripts/fetch-airsnip.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13"
  }
}
